  "entries": [
    {"queue_id":"prefixed_dialogue:5902FB","jp":"う……","ko":"으……"},
    {"queue_id":"prefixed_dialogue:5919FC","jp":"よいか！","ko":"잘 들어라！"},
    {"queue_id":"prefixed_dialogue:59268D","jp":"なにっ！　ティタ－ンズか！？","ko":"뭐라고！　티탄즈냐！？"},
    {"queue_id":"prefixed_dialogue:5926EE","jp":"ふんっ！　ほざきよるわ！！","ko":"흥！　지껄이는군！！"},
    {"queue_id":"prefixed_dialogue:592976","jp":"あっ！　ありがとうございます！！","ko":"아！　감사합니다！！"},
    {"queue_id":"prefixed_dialogue:592B05","jp":"もちろんだ！　今日、ここでっ！","ko":"물론이다！　오늘、여기서！"},
    {"queue_id":"prefixed_dialogue:592BD9","jp":"チッ！　まだか！！","ko":"칫！　아직이냐！！"},
    {"queue_id":"prefixed_dialogue:592C70","jp":"……今だ！","ko":"……지금이다！"},
    {"queue_id":"prefixed_dialogue:592C92","jp":"……ああ！","ko":"……그래！"},
    {"queue_id":"prefixed_dialogue:592CD3","jp":"……っ！","ko":"……읏！"},
    {"queue_id":"prefixed_dialogue:592D21","jp":"……あ、ああっ！　わかった！！","ko":"……으、응！　알았어！！"},
    {"queue_id":"prefixed_dialogue:592D3C","jp":"……っ！？","ko":"……읏！？"},
    {"queue_id":"prefixed_dialogue:592D63","jp":"ぬぅっ！　デビルガンダムがっ！！","ko":"으윽！　데빌 건담이！！"},
    {"queue_id":"prefixed_dialogue:592DCE","jp":"プル！？　どうしたんだっ！？","ko":"플！？　무슨 일이야！？"},
    {"queue_id":"prefixed_dialogue:592EAD","jp":"……っ！！","ko":"……윽！！"},
    {"queue_id":"prefixed_dialogue:592F78","jp":"……へぇ、","ko":"……흐음、"},
    {"queue_id":"prefixed_dialogue:5930CF","jp":"なんだと！　コイツ……っ！！","ko":"뭐라고！　이 녀석……！！"},
    {"queue_id":"prefixed_dialogue:593311","jp":"コイツ！　また来ようってのか！？","ko":"이 녀석！　또 오겠다는 거냐！？"},
    {"queue_id":"prefixed_dialogue:59334F","jp":"……プルっ！！　ダメだっ！！","ko":"……플！！　안 돼！！"},
    {"queue_id":"prefixed_dialogue:5934BA","jp":"……くっ！！","ko":"……윽！！"},
    {"queue_id":"prefixed_dialogue:594FED","jp":"……はっ。","ko":"……옛。"},
    {"queue_id":"prefixed_dialogue:595123","jp":"っ！　む、無念……！！","ko":"읏！　무、무념……！！"},
    {"queue_id":"prefixed_dialogue:59534C","jp":"……ん？","ko":"……응？"},
    {"queue_id":"prefixed_dialogue:59560E","jp":"よし！","ko":"좋아！"},
    {"queue_id":"prefixed_dialogue:595BB3","jp":"っ！　そいつぁ……！！","ko":"읏！　그건……！！"},
    {"queue_id":"prefixed_dialogue:596163","jp":"ああ……","ko":"그래……"},
    {"queue_id":"prefixed_dialogue:596243","jp":"……シ－マ様？","ko":"……시마 님？"},
    {"queue_id":"prefixed_dialogue:5964C1","jp":"……そう！　甘いのだ、私は！！","ko":"……그래！　무른 거야、나는！！"},
    {"queue_id":"prefixed_dialogue:59657E","jp":"では、行くぞ！　ヒイロ・ユイ！！","ko":"그럼、간다！　히이로・유이！！"},
    {"queue_id":"prefixed_dialogue:5966FC","jp":"ゼクス・マ－キスっ！！","ko":"젝스・마키스！！"},
    {"queue_id":"prefixed_dialogue:596711","jp":"ぬうっ……！！","ko":"으윽……！！"},
    {"queue_id":"prefixed_dialogue:596725","jp":"だが！　まだっ！！","ko":"하지만！　아직！！"},
    {"queue_id":"prefixed_dialogue:5967F3","jp":"兄……？","ko":"형……？"},
    {"queue_id":"prefixed_dialogue:59699B","jp":"そうだ！　それでこそ命を賭ける","ko":"그래！　그래야 목숨을 거는"},
    {"queue_id":"prefixed_dialogue:596A66","jp":"……いや。","ko":"……아니。"},
    {"queue_id":"prefixed_dialogue:5970BE","jp":"……おや、","ko":"……이런、"},
    {"queue_id":"prefixed_dialogue:5971F1","jp":"むっ……","ko":"음……"},
    {"queue_id":"prefixed_dialogue:597350","jp":"直上に敵機！　ガンダムです！！","ko":"바로 위에 적기！　건담입니다！！"},
    {"queue_id":"prefixed_dialogue:59737B","jp":"あっ！　デキム様！！","ko":"아！　데킴 님！！"},
    {"queue_id":"prefixed_dialogue:59788C","jp":"っ！　モ、モビルス－ツ！！","ko":"읏！　모、모빌슈트！！"},
    {"queue_id":"prefixed_dialogue:597928","jp":"ふ……","ko":"으……"},
    {"queue_id":"prefixed_dialogue:5979A3","jp":"っ！　マザ－バンガ－ドが！！","ko":"읏！　마더 뱅가드가！！"},
    {"queue_id":"prefixed_dialogue:5979C2","jp":"っ！　べラ……すまないっ！！","ko":"읏！　베라……미안하다！！"},
    {"queue_id":"prefixed_dialogue:597A0C","jp":"しまった！　シャトルが……！！","ko":"이런！　셔틀이……！！"},
    {"queue_id":"prefixed_dialogue:597A6C","jp":"ふふ……","ko":"후후……"},
    {"queue_id":"prefixed_dialogue:597A7A","jp":"ザビ－ネっ！　キサマ……！？","ko":"자비네！　네놈……！？"},
    {"queue_id":"prefixed_dialogue:597AA7","jp":"くっ……！","ko":"윽……！"},
    {"queue_id":"prefixed_dialogue:597AD7","jp":"はははっ！　裏切り！？","ko":"하하핫！　배신！？"},
    {"queue_id":"prefixed_dialogue:597C09","jp":"貴様……！！","ko":"네놈……！！"},
    {"queue_id":"prefixed_dialogue:597C16","jp":"く　くくく！","ko":"크　크크크！"},
    {"queue_id":"prefixed_dialogue:597CB2","jp":"罪をつぐなえっ！　キンケドゥ！！","ko":"죗값을 치러라！　킨케두！！"},
    {"queue_id":"prefixed_dialogue:597D15","jp":"さようなら！　キンケドゥ！！","ko":"잘 가라！　킨케두！！"},
    {"queue_id":"prefixed_dialogue:597D2A","jp":"っ！　ガ、ガンダムが！？","ko":"읏！　거、건담이！？"},
    {"queue_id":"prefixed_dialogue:597DF0","jp":"くっ……","ko":"윽……"},
    {"queue_id":"prefixed_dialogue:597FA8","jp":"マザ－・バンガ－ドとべラ・ロナが","ko":"마더・뱅가드와 베라・로나가"},
    {"queue_id":"prefixed_dialogue:5981A7","jp":"だが……","ko":"하지만……"},
    {"queue_id":"prefixed_dialogue:59828F","jp":"ブライト艦長！　マザ－バンガ－ドの","ko":"브라이트 함장！　마더・뱅가드의"},
    {"queue_id":"prefixed_dialogue:59843F","jp":"……よし。","ko":"……좋아。"},
    {"queue_id":"prefixed_dialogue:598AE5","jp":"うぅ……","ko":"으으……"},
    {"queue_id":"prefixed_dialogue:598E06","jp":"さて……","ko":"자……"},
    {"queue_id":"prefixed_dialogue:598FD1","jp":"……え？　ボ、ボクですか？","ko":"……네？　저、저 말입니까？"},
    {"queue_id":"prefixed_dialogue:5993B8","jp":"……おかしいですよ！","ko":"……이상하잖아요！"},
    {"queue_id":"prefixed_dialogue:5993C7","jp":"……ロ－ラ。","ko":"……로라。"},
    {"queue_id":"prefixed_dialogue:5993E0","jp":"ボクはロランです！！","ko":"저는 로랑입니다！！"},
    {"queue_id":"prefixed_dialogue:5993F1","jp":"ロ－ラ！！","ko":"로라！！"},
    {"queue_id":"prefixed_dialogue:599404","jp":"グエン卿のやろうとしていることは","ko":"그웬 경이 하려는 일은"},
    {"queue_id":"prefixed_dialogue:599420","jp":"待て、ロ－ラ！！","ko":"기다려、로라！！"},
    {"queue_id":"prefixed_dialogue:599436","jp":"誰か！！","ko":"누구 없어요！！"},
    {"queue_id":"prefixed_dialogue:599455","jp":"なにっ！！","ko":"뭐라고！！"},
    {"queue_id":"prefixed_dialogue:599477","jp":"すみません……。","ko":"죄송합니다……。"},
    {"queue_id":"prefixed_dialogue:599494","jp":"いや、ロランを責めるつもりはない。","ko":"아니、로랑을 탓할 생각은 없다。"},
    {"queue_id":"prefixed_dialogue:5994A7","jp":"しかし、ウィルゲムを失ったのは","ko":"하지만、윌게임을 잃은 것은"},
    {"queue_id":"prefixed_dialogue:5994C1","jp":"クロスボ－ン・バンガ－ドが","ko":"크로스본・뱅가드가"},
    {"queue_id":"prefixed_dialogue:599542","jp":"コウ・ウラキ……呐喊します！！","ko":"코우・우라키……돌격합니다！！"},
    {"queue_id":"prefixed_dialogue:599571","jp":"まだ、抵抗するのなら……！！","ko":"아직、저항한다면……！！"},
    {"queue_id":"prefixed_dialogue:59958D","jp":"ここからいなくなれぇぇっ！！","ko":"여기서 사라져어어！！"},
    {"queue_id":"prefixed_dialogue:5995BA","jp":"……ファンネルっ！！","ko":"……판넬！！"},
    {"queue_id":"prefixed_dialogue:599637","jp":"いっけぇぇ……ハイメガキャノン！！","ko":"가라아아……하이 메가 캐논！！"},
    {"queue_id":"prefixed_dialogue:599668","jp":"いけっ！　フィン・ファンネル！！","ko":"가라！　핀・판넬！！"},
    {"queue_id":"prefixed_dialogue:599696","jp":"なんとぉ－－っ！！","ko":"뭐라고오－－！！"},
    {"queue_id":"prefixed_dialogue:5996C0","jp":"Ｖ２の、光の翼でぇぇっ！！","ko":"Ｖ２의、빛의 날개로오오！！"},
    {"queue_id":"prefixed_dialogue:5996EF","jp":"まやかすなぁぁ－－っ！！","ko":"속이지 마라아아－－！！"},
    {"queue_id":"prefixed_dialogue:59971D","jp":"オレのこの手が真っ赤に燃えるっ！！","ko":"내 이 손이 새빨갛게 타오른다！！"},
    {"queue_id":"prefixed_dialogue:59973F","jp":"勝利をつかめととどろき叫ぶぅっ！！","ko":"승리를 잡으라며 우렁차게 외친다아！！"},
    {"queue_id":"prefixed_dialogue:59975B","jp":"ぶわぁぁぁく熱っ！！","ko":"포오오옥열！！"},
    {"queue_id":"prefixed_dialogue:599782","jp":"フィンガァァァ－－ッ！！","ko":"핑거어어어－－！！"},
    {"queue_id":"prefixed_dialogue:5997A8","jp":"キング・オブ・ハ－トの名にかけて！！","ko":"킹・오브・하트의 이름을 걸고！！"},
    {"queue_id":"prefixed_dialogue:5997BF","jp":"オレのこの手が真っ赤に燃えるっ！！","ko":"내 이 손이 새빨갛게 타오른다！！"},
    {"queue_id":"prefixed_dialogue:5997E1","jp":"勝利をつかめととどろき叫ぶ！！","ko":"승리를 잡으라며 우렁차게 외친다！！"},
    {"queue_id":"prefixed_dialogue:5997FA","jp":"ばぁぁぁく熱！！","ko":"포오오옥열！！"},
    {"queue_id":"prefixed_dialogue:599841","jp":"流派、東方不敗！","ko":"유파、동방불패！"},
    {"queue_id":"prefixed_dialogue:59987B","jp":"天驚けぇぇぇぇんっ！！","ko":"천경권어어어！！"},
    {"queue_id":"prefixed_dialogue:5998A3","jp":"この、愚か者めがぁぁっ！！","ko":"이、어리석은 놈아아！！"},
    {"queue_id":"prefixed_dialogue:5998C2","jp":"ダァァァァクネス……","ko":"다아아아크니스……"},
    {"queue_id":"prefixed_dialogue:5998DE","jp":"フィンガ－－－－ッ！！","ko":"핑거어어어－－！！"},
    {"queue_id":"prefixed_dialogue:599923","jp":"十二王っ！……方牌！！","ko":"십이왕！……방패！！"},
    {"queue_id":"prefixed_dialogue:59993C","jp":"大車りぃぃぃぃんっ！！","ko":"대차병！！"},
    {"queue_id":"prefixed_dialogue:59996D","jp":"……流派！！","ko":"……유파！！"},
    {"queue_id":"prefixed_dialogue:5999CE","jp":"任務了解……破壊する","ko":"임무 이해……파괴한다"},
    {"queue_id":"prefixed_dialogue:599A2E","jp":"照準用レ－ザ－、進路クリア！","ko":"조준용 레이저、진로 클리어！"},
    {"queue_id":"prefixed_dialogue:599A5B","jp":"行ぃっけぇぇ－－っ！！","ko":"가아아라－－！！"},
    {"queue_id":"prefixed_dialogue:599A82","jp":"戦いの歴史は繰り返させません！！","ko":"전쟁의 역사를 되풀이하게 두지 않겠습니다！！"},
    {"queue_id":"prefixed_dialogue:599AB3","jp":"……月光蝶であるっ！！","ko":"……월광접이다！！"},
    {"queue_id":"prefixed_dialogue:599ADD","jp":"これで決める……！！","ko":"이걸로 끝낸다……！！"},
    {"queue_id":"prefixed_dialogue:599AF9","jp":"改造を行っています。","ko":"개조를 진행하고 있습니다。"},
    {"queue_id":"prefixed_dialogue:599B0B","jp":"少しばかり待ってくれよ。","ko":"잠시만 기다려 줘。"},
    {"queue_id":"prefixed_dialogue:599B26","jp":"大切な…力……","ko":"소중한…힘……"},
    {"queue_id":"prefixed_dialogue:599233","jp":"………ッ！","ko":"………큭！"},
    {"queue_id":"prefixed_dialogue:599907","jp":"つけあがるなぁっ！！","ko":"기어오르지 마라！！"}
  ]
}
