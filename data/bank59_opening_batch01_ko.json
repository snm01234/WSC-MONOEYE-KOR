  },
  "entries": [
    {
      "abs": "590005",
      "source": "……思ったより연방の兵力が少ないな。",
      "ko": "……생각보다 연방군이 적구나。"
    },
    {
      "abs": "59001B",
      "source": "ソ－ラ・レイの力か……",
      "ko": "솔라 레이의 위력인가……"
    },
    {
      "abs": "590030",
      "source": "聞け！",
      "ko": "들어라！"
    },
    {
      "abs": "590038",
      "source": "我が忠勇なる지온병사諸君よ！！",
      "ko": "충용한 지온 병사들이여！！"
    },
    {
      "abs": "590049",
      "source": "今や지구　연방군함대の半数が",
      "ko": "이제 지구연방군 함대의 절반은"
    },
    {
      "abs": "590055",
      "source": "我がソ－ラ・レイによって우주に消えた！",
      "ko": "우리 솔라 레이에 의해 우주에서 사라졌다！"
    },
    {
      "abs": "590070",
      "source": "決定的打撃を受けた지구　연방군に、",
      "ko": "치명타를 입은 지구연방군에"
    },
    {
      "abs": "590086",
      "source": "いかほどの戦力が残っていようと……",
      "ko": "아무리 전력이 남아 있더라도……"
    },
    {
      "abs": "590095",
      "source": "それはすでに形骸である！",
      "ko": "이미 허울뿐이다！"
    },
    {
      "abs": "5900AD",
      "source": "あえて言おう……カスであると！！",
      "ko": "감히 말하겠다…… 쓰레기라고！！"
    },
    {
      "abs": "5900C7",
      "source": "それら惰弱の集団が、ア・バオア・ク－を",
      "ko": "그 나약한 무리가 아 바오아 쿠를"
    },
    {
      "abs": "5900E1",
      "source": "抜くことはできないと私は断言する！！",
      "ko": "함락할 수 없다고 단언한다！！"
    },
    {
      "abs": "5900FF",
      "source": "……인류は！",
      "ko": "……인류는！"
    },
    {
      "abs": "59010A",
      "source": "我ら選ばれた優良種たる지온国民に",
      "ko": "선택받은 우량종인 지온 국민이"
    },
    {
      "abs": "590120",
      "source": "管理運営されて、初めて！",
      "ko": "관리하고 이끌 때 비로소！"
    },
    {
      "abs": "590132",
      "source": "生き延びることができる！！",
      "ko": "살아남을 수 있다！！"
    },
    {
      "abs": "590149",
      "source": "지구연방の無能なる者共に思い知らせ……",
      "ko": "무능한 지구연방 놈들에게 똑똑히 보여 주고……"
    },
    {
      "abs": "590160",
      "source": "明日の미래のために、我ら지온공국国民は",
      "ko": "미래를 위해 우리 지온 공국 국민은"
    },
    {
      "abs": "590175",
      "source": "立たねばならんのである！",
      "ko": "일어서야 한다！"
    },
    {
      "abs": "59018B",
      "source": "こちらＳフィ－ルド방어線区사령",
      "ko": "이쪽은 S 필드 방어선 사령관"
    },
    {
      "abs": "59019D",
      "source": "에기유・델라즈である！！",
      "ko": "에규 데라즈다！！"
    },
    {
      "abs": "5901B2",
      "source": "この度の戦いは、",
      "ko": "이번 전투는"
    },
    {
      "abs": "5901BF",
      "source": "지온공국の命運をかけたー戦である！",
      "ko": "지온 공국의 운명을 건 결전이다！"
    },
    {
      "abs": "5901CF",
      "source": "我らスぺ－ス・ノイドの自立のため、",
      "ko": "우리 스페이스 노이드의 자립을 위해"
    },
    {
      "abs": "5901E3",
      "source": "呪わしき연방の呪縛をふり払うため……",
      "ko": "저주스러운 연방의 속박을 떨치기 위해……"
    },
    {
      "abs": "5901F9",
      "source": "병사諸君にはいっそうの奮闘を期待する！",
      "ko": "병사 여러분의 분전을 기대한다！"
    },
    {
      "abs": "59022E",
      "source": "どうした……세라？",
      "ko": "왜 그러지…… 세라？"
    }
  ]
}
