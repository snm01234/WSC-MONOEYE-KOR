  "targets": {
    "63BE87": "그래서　우린　연방군　공격에　앞서、",
    "63BE9B": "루나２　함대를　공격한다。",
    "63BEC5": "적　진형을　흐트러뜨리고、　ＭＳ대가",
    "63BED9": "전함　지원으로　적　함대를　친다。",
    "63BEEC": "또、　이　작전에는　키시리아　소장의",
    "63BEFC": "그와리브도　참가한다。",
    "63BF06": "이　싸움이　지온의　운명을　결정한다",
    "63BF18": "해도　틀린　말은　아니겠지。",
    "63BF27": "각자、　그　각오로　분투해주게。",
    "63BF3C": "우리　사이클롭스대가　사이드６에",
    "63BF4E": "잠입　중임이　밝혀졌다。",
    "63BF60": "그들은　핵공격　중지를　모른　채、",
    "63BF75": "적　신형기　파괴공작을　계속한다。",
    "63BF8B": "우리　목적은　사이클롭스대의",
    "63BF9A": "철수를　지원하는　것이다。",
    "63BFA4": "먼저　브라드　중령의　무사이가",
    "63BFB1": "사이드６에　침입……",
    "63BFBC": "모빌슈트대를　상륙시킨　뒤、",
    "63BFC9": "사이클롭스대와　접촉한다。",
    "63BFD4": "이후　사이클롭스대를　엄호하며",
    "63BFE4": "사이드６에서　철수한다。",
    "63BFF5": "사이드６는　중립지대지만、",
    "63C001": "연방군이　주둔한다는　정보도　있다。",
    "63C028": "사이드６와의　중립협정　때문에、",
    "63C03C": "전　부대로　진격할　수는　없다。",
    "63C04B": "그래서　사이클롭스대　구출은",
    "63C059": "내가　지휘하는　무사이만　맡는다。",
    "63C068": "출격　예정　파일럿은、",
    "63C073": "무사이에　탑승해두도록。",
    "63C091": "샤아　대령은　기체조정으로　부재중이라、",
    "63C0A5": "내가　대신　작전을　설명한다。",
    "63C0B7": "먼저、　현재　상황은……",
    "63C0C7": "아　바오아　쿠로　향한　연방군은、",
    "63C0D8": "우리　솔라　레이로、",
    "63C0E6": "함대의　３０％를　잃었다。",
    "63C0F7": "잔존부대는　재집결을　마쳤고、",
    "63C10B": "곧　아　바오아　쿠에　도착한다。",
    "63C11C": "우리　임무는　수비대의　일원으로",
    "63C12C": "아　바오아　쿠를　지키는　것이다。",
    "63C14C": "그　『목마』와　함께、",
    "63C15D": "연방　주력부대가　몰린　격전지다。",
    "63C170": "아마　힘든　싸움이　되겠지만……",
    "63C17E": "각자、　끝까지　살아남아",
    "63C18D": "싸움의　끝을　지켜봐주게。",
    "63C1BD": "우군과　잘　접촉할　수",
    "63C1C7": "있으면　좋겠는데……",
    "63C1DC": "우리　액시즈　선견함대는　데라즈　플리트",
    "63C1EC": "구출을　위해　솔로몬으로　향한다。",
    "63C1FD": "적은　솔로몬에　집결중인　연방함대。",
    "63C20C": "아나벨　가토　소령의　활약으로、",
    "63C21D": "함정　대부분은　이미　격침됐지만……",
    "63C230": "아직도　적　부대는　많다。",
    "63C241": "특히　알비온이란　전함엔、",
    "63C24F": "건담이　실렸다는　정보도　있다。",
    "63C25F": "이대로면　데라즈　플리트의",
    "63C269": "전멸은　피할　수　없다。",
    "63C272": "무슨　수를　써서든　플리트를　지켜",
    "63C281": "솔로몬에서　철수시켜라。",
    "63C2D7": "……현재　『별의　부스러기　작전』은",
    "63C2ED": "최종단계에　들어섰다。",
    "63C2F9": "이미　별동대　시마　함대가",
    "63C307": "콜로니　아일랜드　이즈를　탈취했고……",
    "63C317": "곧　콜로니는　낙하궤도에　진입한다。",
    "63C327": "데라즈　플리트의　용사들이여！",
    "63C338": "콜로니가　낙하궤도에　들　때까지",
    "63C349": "목숨을　걸고　지켜주길　바란다！！",
    "63C35C": "콜로니　낙하의　성공으로、",
    "63C36C": "『별의　부스러기』는　완성된다！",
    "63C3A4": "그리프스에서　시험중인",
    "63C3AE": "티탄즈　신형　모빌슈트의　정찰이다。",
    "63C3BB": "먼저　나와　아폴리、　로베르토가",
    "63C3C7": "그리프스에　잠입한다。",
    "63C3D1": "나머지는　아가마에서　대기한다。",
    "63C3E0": "티탄즈와　접촉하면、",
    "63C3ED": "전투로　이어질　가능성도　높다。",
    "63C3FD": "각자、　언제든　출격하도록",
    "63C408": "준비를　마쳐두게。",
    "63C426": "방금　티탄즈의　통보입니다만、",
    "63C436": "준장님은　어쩌실　겁니까？",
    "63C452": "……놈들　지시대로、",
    "63C45F": "지정　공역으로　갈　수밖에　없다。",
    "63C476": "하지만、　준장님。",
    "63C480": "그건　스스로　함정에　드는　꼴입니다……",
    "63C496": "죄없는　사람들이　처형되는　걸",
    "63C4A7": "모른　척할　수는　없잖나！",
    "63C4BB": "……지금은　따를　수밖에　없다。",
    "63C4E2": "곧　사다란에서　회담이　열린다。",
    "63C50B": "우린　블랙스　준장과",
    "63C516": "크와트로　대위가　참석한다。",
    "63C522": "우린　만일의　사태에　대비해、",
    "63C530": "사다란　근처에서　대기한다。",
    "63C53E": "각　파일럿은　상황　발생시",
    "63C550": "즉시　출격할　준비를　해둬라！",
    "63C560": "시그　중위와　레코아　소위는　호위로",
    "63C573": "준장과　동행한다。",
    "63C57D": "출격　멤버를　배치할　때는、",
    "63C58C": "이　점을　주의하도록！",
    "63C5B9": "홍콩에서　카라바와　합류해、",
    "63C5C5": "보급과　정비를　한다。",
    "63C5D2": "보급이　끝날　때까진、　각　승무원에게",
    "63C5E3": "상륙휴가를　줄　예정이다。",
    "63C5FE": "역시　브라이트　함장！",
    "63C60C": "통도　크잖아！",
    "63C62E": "아시아엔　티탄즈의",
    "63C63A": "무라사메　연구소도　있지만……",
    "63C648": "뭐……　티탄즈라도",
    "63C656": "도심에서　싸움을　걸진　않겠지。",
    "63C66C": "게다가　보급중엔　카라바　부대가",
    "63C67D": "호위를　맡는다。",
    "63C68B": "각자、　안심하고",
    "63C694": "지금　푹　쉬어두게。",
    "63C6B9": "이번　임무는　지구로　가는",
    "63C6CA": "네오　지온　함대　추격이다！",
    "63C6D8": "현재　네오　지온함대는　아프리카에",
    "63C6EA": "강하하려　위성궤도로　향하고　있다。",
    "63C6F9": "적은　매우　큰　함대라、",
    "63C70B": "우리와　전력차가　상당히　크다。",
    "63C71C": "그래서　적　함대가　대기권에",
    "63C72A": "진입하는　틈을　노려　공격한다。",
    "63C73C": "제１목표는　적　기함　사다란의　파괴！",
    "63C74E": "어려우면　강하궤도를　흐트러뜨려",
    "63C766": "다카르　진군을　늦춘다。",
    "63C777": "２단계　작전이란　거군……",
    "63C797": "싸움은　두세　수　앞을　보고　하라고",
    "63C7AF": "크와트로　대위가　가르쳤으니까요。",
    "63C7F2": "네오　지온　함대의　전력은……",
    "63C802": "기함　사다란을　중심으로、",
    "63C80D": "엔드라형　순양함이　다수。",
    "63C820": "각　함엔　직엄　모빌슈트가",
    "63C82F": "실려　있을　것으로　보입니다。",
    "63C839": "적　주력은　가자형　모빌슈트。",
    "63C849": "……그쪽은　그리　두렵지　않군。",
    "63C85B": "오히려　진짜　경계할　것은",
    "63C868": "장교용　커스텀기겠지。",
    "63C875": "네、　대위님　말씀대로입니다。",
    "63C885": "가자형은　변형능력이　있지만、",
    "63C896": "전투력은　그리　높지　않습니다。",
    "63C8A3": "한편　장교용　자쿠Ⅲ　등은",
    "63C8B2": "중화력이라　주의가　필요합니다。",
    "63C8CA": "각자、　지금　정보를　바탕으로",
    "63C8DB": "전투준비를　해두도록！",
    "63C8F3": "토레스、　상황을　설명해。",
    "63C926": "에우고　본부　정보에　따르면……",
    "63C937": "이곳은　뉴타입　연구소로、",
    "63C944": "티탄즈의　지휘하에　있답니다。",
    "63C954": "또、　이　기지는　현재、",
    "63C963": "누군가와　교전중이며……",
    "63C971": "여기서　무슨　일이　있는지",
    "63C984": "확인하는　게　우리　목적이다。",
    "63C98D": "경우에　따라선　티탄즈와",
    "63C997": "전투가　벌어질　수도　있다。",
    "63C9A4": "각자、　준비를　게을리하지　마라！",
    "63C9BB": "이번　목표는、",
    "63C9C6": "킬리만자로　기지　공략이다。",
    "63C9D2": "먼저、　토레스。",
    "63C9DA": "적　전력　정보를　말해줘。",
    "63C9F7": "킬리만자로　기지는　티탄즈의",
    "63CA03": "중요　거점　중　하나이며、",
    "63CA0F": "그　방어에　많은　전력이",
    "63CA1E": "배치돼　있습니다。",
    "63CA28": "현재　확인된　바로는、",
    "63CA36": "모빌슈트대가　약　１개　사단。",
    "63CA47": "우리　전력의　거의　２배입니다。",
    "63CA5F": "또　뉴타입연구소의　시험기도",
    "63CA73": "반입됐다는　정보가　있습니다。",
    "63CA82": "그야말로　대단한　진용이군……",
    "63CA95": "하지만、　그게　노림수이기도　해。",
    "63CAA7": "티탄즈는　이　전력을　믿고",
    "63CAB4": "방심한　듯　경계가　느슨하다。",
    "63CAC5": "우린　적의　감시망　틈을　타、",
    "63CADA": "킬리만자로에　접근……",
    "63CAE3": "적이　대비하기　전에　기지를　함락한다。",
    "63CB0C": "킬리만자로를　함락하면、",
    "63CB18": "티탄즈　전력은　크게　떨어진다。",
    "63CB42": "그런데　브라이트　중령、",
    "63CB4D": "카미유는　어쩔　생각인가？",
    "63CB75": "작전　전에　데려오면　좋겠지만、",
    "63CB88": "아마、　무리겠지。",
    "63CB95": "그렇다면　카미유와　크와트로　대위가",
    "63CBA5": "없는　전제로　편성해야겠군……",
    "63CBC0": "예정밖　전투로　시간을　썼지만",
    "63CBD3": "작전에는　변경이　없다。",
    "63CBDF": "우린　이제　다카르로　가서、",
    "63CBEC": "네오　지온함대를　추격한다。",
    "63CBFE": "적　목표는　다카르의　연방의회며、",
    "63CC0D": "이를　막는　게　당면　목표다。",
    "63CC1C": "각자、　언제든　전투하도록",
    "63CC2B": "준비해두기　바란다。",
    "63CC3F": "아、　브라이트　함장。",
    "63CC4A": "하나　걸리는　게　있는데요……",
    "63CC56": "응、　뭔데、　토레스？",
    "63CC66": "실은　아프리카에　소속불명의",
    "63CC75": "거대　모빌슈트가　나타났답니다……",
    "63CC95": "건담　타입이라던데、",
    "63CCA0": "현재　카라바에　조회중입니다。",
    "63CCB2": "소속불명의　건담인가……",
    "63D02F": "토레스、　적　부대　정보를。",
    "63D063": "이들은　대위의　연설과　동시에",
    "63D074": "의사당을　제압하러　갈　겁니다。",
    "63D085": "이들을　팝티머스　시로코가",
    "63D092": "이끈다는　정보도　있으며……",
    "63D0A0": "신형　모빌슈트도",
    "63D0A7": "우선적으로　배치된　듯합니다。",
    "63D0B9": "현재　전력균형을　뒤집으려면、",
    "63D0CF": "무슨　수를　써서든　의회를　얻어야　해。",
    "63D0E2": "각자、　부탁한다！",
    "63D102": "우리　목표는　다카르　의회를",
    "63D110": "네오　지온군에게서　해방하는　것이다！",
    "63D11F": "토레스、　적　전력　정보를。",
    "63D138": "다카르를　점령한　네오　지온군은",
    "63D14A": "지금도　도시에　주둔중입니다。",
    "63D15B": "네오　지온　기함　사다란과　함께",
    "63D16D": "엔드라급　순양함도　다수　확인됐습니다",
    "63D184": "그　데빌　건담이라는",
    "63D18E": "모빌슈트는　어떻게　됐지？",
    "63D198": "데빌　건담의　재생능력을　생각하면",
    "63D1A7": "나타나도　이상하지　않아。",
    "63D1C3": "하지만　의회를　이대로",
    "63D1D0": "네오　지온에　점령시킬　순　없다",
    "63D1E3": "힘든　싸움이　되겠지만、",
    "63D1ED": "각자、　분투해주기　바란다！",
    "63D1FF": "히이로　유이가　사라졌다니……",
    "63D20F": "대체、　어디로　간　거지？",
    "63D21F": "……결판을　내러　갔군。",
    "63D23F": "그　젝스　마키스라는　남자……",
    "63D251": "그와　결판을　내러　갔겠지。",
    "63D27D": "……아니、　그만두자。",
