    "63A8D2": "마지막에……",
    "63A8DB": "시그와、　만나서……",
    "63A913": "미안…을……",
    "63A91F": "소중히…　여겨줘……",
    "63A9BB": "……미안해。",
    "63A9C4": "잠깐만……　혼자　있게　해줘。",
    "63AA09": "이걸로　잘된　거겠지……",
    "63AA17": "……세라。",
    "63AA26": "………！？",
    "63AA5B": "그래……　세라。",
    "63AA6F": "………！！",
    "63AA81": "……미안！？",
    "63AA97": "못　보겠어……　시그。",
    "63AAA4": "그렇게、　고민하고、　괴로워하고……",
    "63AAB5": "……그러니　내가　대신할게！",
    "63AAE9": "세라……　미안해！！",
    "63AB40": "미안……　도망쳐！！",
    "63AB6F": "……미안！！",
    "63ABA1": "아하……",
    "63ABA9": "조금…　버거웠나……",
    "63ABBA": "……미안！！",
    "63ABCF": "쓰러뜨리는　건……",
    "63ABDB": "무리…였나　봐……",
    "63AC03": "바보、　같네…　나……",
    "63AC15": "……미안！！",
    "63AC2E": "세라를……",
    "63AC35": "구해…줘……",
    "63AC7F": "나를　죽여줘……",
    "63AC8A": "더는、　이런　광경을　보는　건……",
    "63ACB7": "……아니、　죽이지　않아。",
    "63ACC9": "……시그！？",
    "63ACD7": "난、　널　구해낼　거야……！！",
    "63ACF3": "반드시　구해내겠어！！",
    "63AD14": "세라……　구하러　왔어。",
    "63AD3B": "너무　늦었어……　시그。",
    "63AD51": "이제　와서　무슨　낯으로",
    "63AD5E": "태연히　살아남을　수　있겠어？",
    "63AD6D": "미안을……",
    "63AD74": "많은　사람을、　내　손으로　죽이고……！",
    "63AD8C": "나째로　기체를　쏴！",
    "63AD99": "지금이면　파괴할　수　있어！！",
    "63B8DA": "우린　화이트　베이스　후방을　치고、",
    "63B8EA": "캐멀　함대와　함께　격파한다。",
    "63B931": "고작　전함　몇척의　부대에",
    "63B941": "대단한　포진이군……",
    "63B963": "『연방의　하얀　악마』도　있다。",
    "63B977": "방심은　금물이다。",
    "63B984": "연방의　하얀　악마……　『건담』인가。",
    "63B9BE": "세레인　소위의　에르메스를",
    "63B9C8": "받으러　사이드５로　간다。",
    "63B9F1": "사이드５　근처　암초공역에서",
    "63B9FE": "적응비행을　실시할　예정이다。",
    "63BA10": "또、　시그　중위와　아인　상사에게도",
    "63BA20": "새　기체가　준비됐다는군。",
    "63BA31": "엇、　정말입니까！？",
    "63BA3E": "기대되네요～！！",
    "63BA63": "기체만　받는　일이라　해도、",
    "63BA72": "연방군과　마주칠　수　있어。",
    "63BA86": "경계만은　게을리하지　마라。",
    "63BABA": "솔로몬　요새의　도즐　중장은",
    "63BAC6": "이에　대비해　방비를　굳혔지만……",
    "63BADB": "본국의　증원이　거부된　탓도　있어、",
    "63BAEE": "방어　전망은　매우　어렵다。",
    "63BB02": "그래서　우리가　돌격기동군　증원으로",
    "63BB11": "솔로몬　요새로　가게　됐다。",
    "63BB21": "솔로몬　우주공격군과　협력해",
    "63BB30": "연방함대를　요격하는　임무다。",
    "63BB49": "덧붙여　말하자면、",
    "63BB5A": "적은　티안무　중장의　우주함대다……",
    "63BB7B": "상당한　수가　확인됐답니다。",
    "63BBAD": "짐　대군에　목마인가……",
    "63BBBC": "상당히　힘든　싸움이　되겠군。",
    "63BBE2": "연방의　전력은　압도적이다。",
    "63BBEF": "잘못하면、　우리가　도착하기　전에",
    "63BBFF": "솔로몬이　함락될　수도　있다。",
    "63BC0F": "무슨　일에도　대응할　수　있게、",
    "63BC20": "준비만은　철저히　해두게。",
    "63BC37": "현재、　그라나다를　떠난　킬링　중령의",
    "63BC4B": "우주함대가　사이드６로　향하고　있다。",
    "63BC5A": "이　함대는　핵미사일을　장비했고、",
    "63BC6B": "목적은　사이드６　핵공격이다。",
    "63BC7B": "이를　방치하면、　지온공국은",
    "63BC89": "정치적으로　곤경에　빠질　게　분명하다。",
    "63BC9F": "사이드６에　대한　핵공격은",
    "63BCB0": "무슨　수를　써서든　막아야　한다。",
    "63BCBD": "그래서　우린　킬링　함대에　앞서",
    "63BCCD": "사이드６　앞에서　포착한다。",
    "63BCDC": "킬링　중령에게　공격을　중지하라고",
    "63BCEB": "권고하는　것이다。",
    "63BCF7": "중령이　권고를　거부할　경우、",
    "63BD09": "무력을　써서라도　저지한다！",
    "63BD55": "모빌슈트도　최신예기라서",
    "63BD69": "되도록　싸우고　싶진　않군요。",
    "63BD7C": "킬링　중령이　순순히　권고를",
    "63BD8A": "따르길　바랄　수밖에　없군。",
    "63BDA3": "현재　연방군은　지온군　최종방어선인",
    "63BDBA": "아　바오아　쿠　요새로　향하고　있다",
    "63BDCC": "적　주력은　레빌　장군의　우주함대다……",
    "63BDE1": "별도로　루나２　함대도　요새공략에",
    "63BDF7": "참가하는　것이　확인됐다。",
    "63BE02": "그　목마……　화이트　베이스를　중심으로、",
    "63BE12": "마젤란급　전함도　다수다。",
    "63BE1E": "각　전함엔　짐급　모빌슈트、",
    "63BE2E": "신형기도　몇기　배치됐다더군。",
    "63BE64": "이　함대가　레빌　함대와　합류하면",
    "63BE74": "우리　군은　곤경에　빠진다。"
  }
}
