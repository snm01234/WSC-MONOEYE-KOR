{
  "description": "Opening~pre-stage1 dialogue including interstitial narration (08 xx 01 17 xx 18 bodies). KO uses each-marker encoding.",
  "lines": [
    {
      "abs": "6040A5",
      "jp": "『サイド３、独立宣言』",
      "ko": "『사이드　３、독립　선언』"
    },
    {
      "abs": "6040B5",
      "jp": "ジオン・ズム・ダイクンの主導により",
      "ko": "지온　다이쿤의　지도　아래"
    },
    {
      "abs": "6040CB",
      "jp": "コロニ－、サイド３は地球より独立",
      "ko": "콜로니、사이드　３는　지구에서　독립"
    },
    {
      "abs": "6040DD",
      "jp": "ここに、ジオン共和国が成立した",
      "ko": "여기에、지온　공화국이　성립했다"
    },
    {
      "abs": "604116",
      "jp": "『ジオン公国宣言』",
      "ko": "『지온　공국　선언』"
    },
    {
      "abs": "604121",
      "jp": "デギン・ザビ首相が初代公王に就任。",
      "ko": "데긴　자비、초대　공왕。"
    },
    {
      "abs": "60413D",
      "jp": "ジオン共和国、公国へと移行。",
      "ko": "지온　공화국에서　공국으로。"
    },
    {
      "abs": "60416E",
      "jp": "『ジオン公国、国家総動員令を発令』",
      "ko": "『지온　공국、총동원령』"
    },
    {
      "abs": "6041AC",
      "jp": "『ー年戦争勃発』",
      "ko": "『１년　전쟁』"
    },
    {
      "abs": "6041B5",
      "jp": "ジオン公国は、",
      "ko": "지온　공국은、"
    },
    {
      "abs": "6041C2",
      "jp": "地球連邦政府に対して宣戦を布告。",
      "ko": "지구　연방에　선전　포고。"
    },
    {
      "abs": "6041D8",
      "jp": "わずか１週間でサイド１、２、４を",
      "ko": "겨우　１주에　사이드　１、２、４를"
    },
    {
      "abs": "6041F0",
      "jp": "電撃的に制圧。",
      "ko": "전격으로　제압。"
    },
    {
      "abs": "6041FB",
      "jp": "続く『ルウム戦役』において",
      "ko": "『루움　전역』에서"
    },
    {
      "abs": "60420E",
      "jp": "連邦軍の宇宙艦隊に圧勝をおさめる。",
      "ko": "연방군의　우주　함대에　압승。"
    },
    {
      "abs": "604247",
      "jp": "『地球侵攻作戦開始』",
      "ko": "『지구　침공　작전　시작』"
    },
    {
      "abs": "604251",
      "jp": "続く３ヶ月にて、公国軍は",
      "ko": "３개월　뒤、공국군은"
    },
    {
      "abs": "604268",
      "jp": "全大陸の３分の２を制圧することに成功。",
      "ko": "대륙의　３분의　２를　제압。"
    },
    {
      "abs": "60427F",
      "jp": "しかし、急速な戦線の拡大により、",
      "ko": "그러나　전선이　커져、"
    },
    {
      "abs": "604296",
      "jp": "進撃速度は低下。戦いは膠着状態に陥る。",
      "ko": "싸움이　오래간다。"
    },
    {
      "abs": "6042D5",
      "jp": "『連邦軍、Ｖ作戦始動』",
      "ko": "『연방군、Ｖ작전　시작』"
    },
    {
      "abs": "60430A",
      "jp": "『連邦軍、オデッサ作戦開始』",
      "ko": "『연방군、오데사　작전　시작』"
    },
    {
      "abs": "604317",
      "jp": "３日間に渡る激戦の末、連邦軍が勝利。",
      "ko": "３일　싸움　끝、연방군　승리。"
    },
    {
      "abs": "604333",
      "jp": "戦局はー気に連邦有利へと傾く。",
      "ko": "연방에　기운다。"
    },
    {
      "abs": "604362",
      "jp": "『ジオン軍、ジャブロ－急襲に失敗』",
      "ko": "『지온군、자브로　실패』"
    },
    {
      "abs": "60438E",
      "jp": "『連邦軍ソロモン攻略艦隊が発進』",
      "ko": "『연방군　솔로몬　출격』"
    },
    {
      "abs": "6043B8",
      "jp": "『キャリフォルニアべ－ス陥落』",
      "ko": "『캘리　베이스　함락』"
    },
    {
      "abs": "6043E1",
      "jp": "時に宇宙世紀００７９、１２月半ば。",
      "ko": "우주세기　００７９、１２월。"
    },
    {
      "abs": "6043F5",
      "jp": "ジオン公国は",
      "ko": "지온　공국은"
    },
    {
      "abs": "604401",
      "jp": "落日の時を迎えようとしていた……",
      "ko": "그　무렵이었다……"
    },
    {
      "abs": "604421",
      "jp": "……………。",
      "ko": "……………。"
    },
    {
      "abs": "604435",
      "jp": "シグ・ウェドナ－少尉、入ります。",
      "ko": "시그　웨드너　소위、들어갑니다。"
    },
    {
      "abs": "604466",
      "jp": "おお、よく来たなシグ中尉。",
      "ko": "오、잘　왔구나　시그　중위。"
    },
    {
      "abs": "60447D",
      "jp": "ブラ－ド中佐。",
      "ko": "브라드　중령。"
    },
    {
      "abs": "604486",
      "jp": "自分に用件というのは……",
      "ko": "내게　할　말은……"
    },
    {
      "abs": "604492",
      "jp": "……ん、『中尉』？",
      "ko": "……응、중위？"
    },
    {
      "abs": "6044A1",
      "jp": "今日付けの辞令だ。",
      "ko": "오늘자　발령이다。"
    },
    {
      "abs": "6044B2",
      "jp": "本日をもってシグ・ウェドナ－少尉は",
      "ko": "오늘부로　시그　웨드너　소위는"
    },
    {
      "abs": "6044C0",
      "jp": "中尉に昇格。",
      "ko": "중위로　승진。"
    },
    {
      "abs": "6044CA",
      "jp": "新編の戦隊でモビルス－ツ隊を",
      "ko": "신편의　전대에서　모빌슈츠　대를"
    },
    {
      "abs": "6044D8",
      "jp": "率いて戦ってもらうことになる。",
      "ko": "이끌고　싸워　주게　될　것이다。"
    },
    {
      "abs": "6044EB",
      "jp": "モビルス－ツ隊を！？",
      "ko": "모빌슈츠대를！？"
    },
    {
      "abs": "6044F9",
      "jp": "……そう。",
      "ko": "……그래。"
    },
    {
      "abs": "604502",
      "jp": "モビルス－ツ隊の隊長だ。",
      "ko": "모빌슈츠　부대의　대장이다。"
    },
    {
      "abs": "60450F",
      "jp": "けど、オレは……いえっ、自分は",
      "ko": "하지만、　나는……아니、　나는"
    },
    {
      "abs": "604521",
      "jp": "まだそんな任務には……",
      "ko": "아직　그런　임무에는……"
    },
    {
      "abs": "604530",
      "jp": "そう謙遜したもんでもないだろう。",
      "ko": "그렇게　겸손할　것도　아니잖아。"
    },
    {
      "abs": "604545",
      "jp": "いくら若いとはいえ、オマエさんだって",
      "ko": "아무리　젊다　해도、　너라도"
    },
    {
      "abs": "604556",
      "jp": "北米の激戦を潜り抜けてきたんだ。",
      "ko": "북미의　격전을　무사히　헤쳐　나왔어。"
    },
    {
      "abs": "60456A",
      "jp": "実力なら十分にある。",
      "ko": "실력이라면　충분히　있다。"
    }
  ]
}
