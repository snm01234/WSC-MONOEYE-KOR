{
  "5C20BD": "전사로 함장 대리를 맡게",
  "5C20CC": "되었다.",
  "5C20D3": "도저히 19세로 안 보이는",
  "5C20E3": "외모가 특징. 노안인가?",
  "5C20FF": "아가마 함장. 전후 한직으로",
  "5C210D": "밀려났으나 훗날 에우고에",
  "5C211A": "합류해 기함 아가마를",
  "5C2127": "지휘하게 되었다.",
  "5C2132": "명대사 탄막이 얇다! 하면",
  "5C2142": "역시 이 사람.",
  "5C2154": "브라드 전대 지휘관.",
  "5C215D": "아내는 도즐과 연이 있었지만",
  "5C216A": "그것에 기대는 것을 거부하고",
  "5C2179": "키시리아 밑으로 간 강직한",
  "5C2187": "무인. 밑바닥 출신 군인으로",
  "5C2197": "부하의 신뢰도 두텁다.",
  "5C21A6": "프리벤터・윈드",
  "5C21B3": "엔드리스 월츠에 등장한",
  "5C21C3": "시기의 젝스 마키스.",
  "5C21CE": "불 끄는 바람이란 뜻으로",
  "5C21DE": "붙은 이름이나 스스로",
  "5C21EC": "그렇게 부르는 점이",
  "5C21F6": "윙다운 감성이다.",
  "5C2206": "네오 지온의 NT 소녀.",
  "5C2212": "액시즈에서 강화 처리를 받은",
  "5C2221": "소녀로 쥬도를 마음에 들어",
  "5C222D": "그와 행동을 함께했다.",
  "5C223A": "일부 팬에게 절대적인 인기를",
  "5C2248": "자랑한다.",
  "5C2254": "네오 지온 강화인간.",
  "5C225E": "엘피 플의 클론이며",
  "5C226A": "성격은 공격적. 그레미의",
  "5C2279": "말로 싸웠으나 마지막에는",
  "5C2285": "쥬도에게 달려갔다.",
  "5C2294": "블랙스・포라",
  "5C229D": "에우고 지도자.",
  "5C22A4": "티탄즈의 전횡에 맞서",
  "5C22B0": "에우고를 결성했다.",
  "5C22BB": "뜻을 이루기 전 총탄에 쓰러져",
  "5C22CE": "크와트로에게 뒤를 맡겼다.",
  "5C22E1": "신생 크로스본 뱅가드",
  "5C22EC": "지도자. 킨케두 등을",
  "5C22F6": "이끌고 목성 제국과 싸운다.",
  "5C2307": "정체는 킨케두(시북",
  "5C2314": "아노)의 연인인",
  "5C2323": "세실리・페어차일드",
  "5C2333": "베르나르도・몬시아",
  "5C233D": "연방군 MS 파일럿.",
  "5C2346": "베이트, 아델과 알비온에",
  "5C2353": "배치되어 데라즈 분쟁을",
  "5C2360": "싸웠다. 실력은 있지만",
  "5C2370": "성격만 보면 심술궂은",
  "5C2381": "아저씨일 뿐이다.",
  "5C2389": "헨켄・베케너",
  "5C2394": "에우고 장교. 라디슈의",
  "5C23A0": "함장을 맡았다. 티탄즈와",
  "5C23AF": "결전에서 에마를 감싸다",
  "5C23BD": "전사했다. 외모와 달리",
  "5C23C9": "여성에게는 상당히",
  "5C23D8": "숙맥이었다.",
  "5C23E2": "포우・에이지",
  "5C23EA": "디아나 카운터 파일럿.",
  "5C23F1": "감정 기복이 심해",
  "5C2402": "작중 무슨 일만 있으면",
  "5C240E": "자주 울었다. 그 울음은",
  "5C241F": "제목에까지 들어갈",
  "5C242C": "정도였다.",
  "5C2439": "티탄즈 파일럿.",
  "5C2440": "제리드를 만난 뒤 늘",
  "5C244E": "그와 함께 행동하며 이끌고",
  "5C245F": "지지한 여성. NT 소질은",
  "5C246F": "있었던 듯하나 남자 보는 눈은",
  "5C247E": "상당히 의문이다…….",
  "5C248A": "마슈마・세로",
  "5C2491": "네오 지온 파일럿.",
  "5C249B": "하만의 추종자이며 기사도",
  "5C24AA": "정신의 화신. 가슴에 하만이",
  "5C24B9": "준 장미를 꽂는다. 코팅해",
  "5C24C8": "시들지 않게 처리했다고",
  "5C24D5": "한다.",
  "5C24E0": "마슈마・세로(강화)",
  "5C24ED": "후에 강화인간으로 조정된",
  "5C24F8": "마슈마 세로.",
  "5C2500": "라칸이 이끈 도벤 울프",
  "5C250E": "부대와 싸워 장렬한 최후를",
  "5C251E": "맞았다.",
  "5C2525": "마리온・웰치",
  "5C252F": "플라나간 기관에서 길러진",
  "5C253A": "NT 소녀. EXAM 개발",
  "5C2548": "실험 중 사고로 정신이",
  "5C2556": "시스템에 흡수되고 말았다.",
  "5C2562": "EXAM 탑재기가 전부 파괴될",
  "5C2570": "때 의식을 되찾았다고 한다.",
  "5C2586": "전대 지휘관 브라드 중령의",
  "5C2591": "딸. 어머니는 제나 자비",
  "5C25A1": "(도즐 자비 부인)의 시녀를",
  "5C25B0": "맡고 있다. 전대 재편 전부터",
  "5C25BD": "시그와 종종 만나",
  "5C25CB": "함께 놀곤 했다.",
  "5C25E4": "전후 에우고 파일럿이 된",
  "5C25ED": "미안은 티탄즈와의",
  "5C25F9": "싸움 과정에서 다시 시그와",
  "5C2609": "재회한다. 자칫 원한에",
  "5C2618": "짓눌릴 듯한 시그를",
  "5C2625": "지탱하며 함께 싸운다.",
  "5C2631": "미네바・라오・자비",
  "5C263B": "본명 미네바 라오 자비.",
  "5C2647": "도즐의 유복녀로 명목상",
  "5C2657": "액시즈 지도자 자리에",
  "5C2663": "있었으나 그리프스 전쟁 중",
  "5C266F": "행방불명된다. ZZ 시기의",
  "5C267F": "미네바는 대역이었다.",
  "5C268B": "미하일・카민스키",
  "5C2698": "지온 특수부대 사이클롭스",
  "5C26A6": "대의 일원이며 술을 좋아하는",
  "5C26B8": "거한. 캠퍼를 몰고",
  "5C26CA": "건담 NT-1에 도전했지만",
  "5C26D8": "숨겨진 무기의 사격을 받아",
  "5C26EA": "전사했다.",
  "5C26F3": "미하엘・게른",
  "5C26FB": "밀리샤 사령관. 문레이스를",
  "5C2708": "독단으로 공격하는 등",
  "5C2718": "무모한 행동이 두드러졌다.",
  "5C2728": "최종화 근처에서 아이 사진을",
  "5C273C": "보고 있었지만 정석을 깨고",
  "5C274B": "무사히 살아남았다.",
  "5C2756": "메리벨・가젯",
  "5C2760": "깅가남 함대 MS",
  "5C276B": "파일럿. 자유분방한 성격으로",
  "5C277D": "주군 깅가남조차",
  "5C2788": "놀리는 대상으로 보았다.",
  "5C2795": "훗날 놀림 대상을",
  "5C27A3": "그웬으로 바꿨다(?).",
  "5C27B4": "야잔・게이블",
  "5C27BE": "티탄즈 파일럿.",
  "5C2868": "야니・오뷔스",
  "5C2872": "밀리샤 병사.",
  "5C2879": "미하엘의 심복으로 용감하며",
  "5C2888": "무모한 성격의 인물.",
  "5C289A": "술에 취한 끝에 술통을",
  "5C28AB": "타고 우주를 표류한 적도",
  "5C28BA": "있다.",
  "5C28C6": "게임 건담 외전의",
  "5C28D6": "주인공. 실력은 일류지만 매우",
  "5C28EA": "과묵하다. ID 명령 대사는",
  "5C28F6": "소설판을 바탕으로 한다.",
  "5C2906": "히이로와 교신은 개더비트",
  "5C2913": "1에서 다시 수록했다.",
  "5C292C": "액시즈 제독으로 선견함대를",
  "5C2938": "지휘해 지구권에 귀환했다.",
  "5C2944": "데라즈 플리트의 최후를",
  "5C294E": "지켜봤다. 데라즈와 친분이",
  "5C295D": "있었던 듯하다.",
  "5C2965": "라이라・미라・라이라",
  "5C296F": "연방군 MS 파일럿.",
  "5C2978": "일류라 부를 만한 실력을",
  "5C2989": "가졌으나 NT에게는",
  "5C2995": "못 미쳐 카미유에게",
  "5C29A1": "패했다. 훗날 배후령으로",
  "5C29AF": "최종화에도 등장.",
  "5C29C3": "네오 지온 파일럿.",
  "5C2A5A": "쥬도의 여동생.",
  "5C2A61": "오빠가 철없었던 탓인지",
  "5C2A6E": "그만큼 야무진 성격의",
  "5C2A7C": "소유자. 한때 행방불명이",
  "5C2A8A": "됐으나 세이라에게 보호되어",
  "5C2A97": "최종화에서 오빠와 재회했다.",
  "5C2AAF": "도리안 외무차관의 딸이며",
  "5C2ABF": "사실 피스크래프트 왕가의",
  "5C2ACA": "공주. 히이로를 별의 왕자",
  "5C2ADA": "님이라 부르는 등",
  "5C2AE6": "세상 물정과 먼 감성의 소유자.",
  "5C2AFC": "루크레치아・노인",
  "5C2B07": "전 OZ 파일럿 교관.",
  "5C2B16": "젝스와는 오랜 사이로 그를",
  "5C2B25": "사랑하고 따랐다. 행동력도",
  "5C2B33": "넘치는 여성으로 마지막에는",
  "5C2B41": "젝스와 함께 화성으로 가는",
  "5C2B53": "해피엔딩을 얻었다.",
  "5C2B6C": "지온계 NT 연구소에서",
  "5C2B7B": "육성된 강화인간. 전투 때와",
  "5C2B86": "평소 성격이 분열돼 있다.",
  "5C2B96": "같은 강화인간 제로와는",
  "5C2BA4": "친밀한 관계인 듯하다.",
  "5C2BB5": "네오 일본의 정비 크루.",
  "5C2BC3": "도몬과는 소꿉친구이며",
  "5C2BD1": "그에게 호감을 품지만",
  "5C2BE0": "그 마음을 좀처럼 알아주지",
  "5C2BEE": "않아 최종화를 맞을 때까지",
  "5C2C00": "기다려야 했다.",
  "5C2C0D": "레인・미카무라(코어)",
  "5C2C1A": "데빌 건담은 여성을 중추에",
  "5C2C24": "흡수해 진정한 힘을 발휘한다.",
  "5C2C34": "그 코어로 흡수된",
  "5C2C42": "레인. 도몬에게 완고한",
  "5C2C50": "태도를 보이나 마지막엔",
  "5C2C60": "그의 고백으로 마음을 열었다.",
  "5C2C79": "에우고 대원으로 파일럿과",
  "5C2C83": "공작원으로 활약했다.",
  "5C2C92": "크와트로(샤아)에게 끌렸으나",
  "5C2CA0": "그가 늘 혼자임을",
  "5C2CAF": "깨닫고는",
  "5C2CBC": "시로코에게 넘어갔다.",
  "5C2CC7": "레코아・론도(적)",
  "5C2CD3": "전 에우고 대원으로",
  "5C2CDE": "시로코에게 끌려 티탄즈에",
  "5C2CEC": "들어갔다. 그리프스 공방전",
  "5C2CF9": "에서 에마와 격전을",
  "5C2D06": "벌여 서로 동귀어진하는",
  "5C2D16": "형태로 산화했다.",
  "5C2D25": "연방군 장군이며 사실상",
  "5C2D37": "최고 지휘관. 역경 속 연방군을",
  "5C2D46": "모아 승리로 이끌었으나",
  "5C2D55": "솔라 레이에 죽었다. 그의",
  "5C2D62": "죽음은 연방에 큰 타격이",
  "5C2D6F": "됐다고 할 수 있다.",
  "5C2D7C": "샤아의 부하로 아폴리의",
  "5C2D88": "파트너. 1년전쟁 뒤 크와트로와",
  "5C2D93": "함께 에우고 파일럿이",
  "5C2D9D": "된다. 훗날 크와트로가 탄",
  "5C2DA9": "셔틀을 지키다 전사했다.",
  "5C2DB8": "로랑・세아크",
  "5C2DC1": "턴에이 건담의 주인공.",
  "5C2DD1": "지구인과 문레이스의",
  "5C2DDC": "공존을 바라는 마음 착한 소년",
  "5C2DEF": "이다. 전쟁 뒤 몰래",
  "5C2DFE": "왕위를 내려놓은 디아나와",
  "5C2E0C": "함께 은거했다.",
  "5C2E1C": "루나2 사령관. 처음엔",
  "5C2E2F": "고압적으로 브라이트 일행을",
  "5C2E3B": "대했으나 파올로 함장의 설득에",
  "5C2E49": "그들의 이해자가 된다.",
  "5C2E53": "훗날 샤아와 싸우다 사망."
}
