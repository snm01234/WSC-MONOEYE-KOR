  "lines": [
    {"abs": "590306", "ko": "가능하면 미래의 파트너에게", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590312", "ko": "숨기는 건 없었으면 해。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590324", "ko": "수、숨기는 거라니……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590333", "ko": "나는、그런……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590340", "ko": "그렇다면、말해 주지 않겠나？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590353", "ko": "으、으으……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590368", "ko": "……아、알았어。말할게。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590378", "ko": "하지만、웃지 말아 줘。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59038A", "ko": "내용에 따라 다르지만。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590452", "ko": "……풋！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59045D", "ko": "아하하핫！ 귀엽잖아！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5904E0", "ko": "……나도 알 수 있어。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5904EF", "ko": "자기 이름에 집착하는 마음은 말이지。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590501", "ko": "내가 세레인・익스페리가 아니라、", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59050E", "ko": "『세라』에 집착하는 것도 마찬가지야。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59058C", "ko": "그래……그럴지도 모르겠군。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5905C3", "ko": "전에 전투가 끝났을 때、", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5905D2", "ko": "시그가 뭔가 말하려다 말았지？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5905E2", "ko": "그게 뭐였지？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5905F1", "ko": "！ 전、전투가 시작되려는데、", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590606", "ko": "갑자기 무슨 말을……！？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59061A", "ko": "……말하고 싶지 않은 건가？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59062C", "ko": "아、아니……그건、그러니까……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590643", "ko": "『이 전투가 끝나면 함께 살자』", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590659", "ko": "……라고？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590663", "ko": "………！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59074E", "ko": "아、아니야！！ 나는……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59076A", "ko": "……아니라면 문제없겠군。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590779", "ko": "내 대답은 『ＯＫ』다。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59078A", "ko": "……어？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590798", "ko": "『함께 살자』는 제안 말이야。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5907AE", "ko": "시그만 괜찮다면、나는……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5907DA", "ko": "나는 내가 평범한 여자와 다르다는 건", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5907EF", "ko": "충분히 알고 있어……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5907FA", "ko": "여자답게 행동하거나、이른바 평범한", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59080F", "ko": "연인처럼 서로 애교를 부린다든가……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590825", "ko": "음… 뭐라고 해야 하나……나는、", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59083F", "ko": "……아앗！ 내가 말하면서도", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5908B7", "ko": "사실은 내가 먼저 말했어야", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5908C9", "ko": "했던 건데……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5908D8", "ko": "……물론 ＯＫ야。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5908E3", "ko": "이 전투가 끝나면、함께 살자", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5908F6", "ko": "……둘이서。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59090F", "ko": "……좋아！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590916", "ko": "그렇게 정했으면 이야기는 빠르지！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590928", "ko": "빨리 연방을 해치우고", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590933", "ko": "이 전쟁을 끝내자！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590949", "ko": "그래！ 두 사람 모두……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590958", "ko": "……아니、부대 전원이군。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590967", "ko": "부대 전원이……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590970", "ko": "모두 함께 이 전투에서 살아남는 거야！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590982", "ko": "가자！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590A48", "ko": "그보다、총수。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590A61", "ko": "어디에 배속되었습니까？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590A70", "ko": "침몰했어……너무 앞서 나갔지。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590A87", "ko": "호오……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590A8F", "ko": "데긴 공왕에게서 조달하신 겁니까……？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590AA7", "ko": "답답하군、키시리아。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590AB6", "ko": "아버지가 그레이트・데긴을 내놓을 것 같나？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590ACD", "ko": "……아닙니다。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590AE1", "ko": "그러니、그런 거다……。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590B04", "ko": "（아버지를 죽인 남자가……！！）", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590BAF", "ko": "……모르겠군。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590BB9", "ko": "붉은 혜성을 잘못 안 것 아닌가？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590BCC", "ko": "………！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590BD6", "ko": "나도 조금은 이름난 파일럿이라고", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590BE5", "ko": "생각했는데 말이야……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590BF0", "ko": "나도 아직 멀었나……하아。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590CA0", "ko": "하、하얀 기체！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590CAC", "ko": "어떤 녀석이 타고 있지？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590CBD", "ko": "그렇군、연방의 뉴타입인가！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590CCB", "ko": "이 흰 늑대가 정중히 대접해 주지。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590CE8", "ko": "찾았다！ 건담！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590D00", "ko": "거물이군……샤아인가！？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590D18", "ko": "보여……！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590D21", "ko": "내게도、적이 보인다！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590D36", "ko": "……뭐지！？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590D40", "ko": "샤아 이상의 뉴타입 같아！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590D56", "ko": "역시 대단하군、아무로……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590D62", "ko": "하지만、그 힘을 준 것은", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590D72", "ko": "라라아일지도 모른다。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590D7B", "ko": "감사히 여기도록 해라！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590D8E", "ko": "……역시 샤아인가！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590DA1", "ko": "네놈이 라라아를 전투에 끌어들였어！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590DBE", "ko": "……！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590EE0", "ko": "네…에……。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590EEE", "ko": "나는 걱정하지 않아도 된다。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590EFC", "ko": "나는 언제나 살아남아 왔고、", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590F0D", "ko": "이번에도 그럴 생각이다。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590F36", "ko": "……거짓말。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590F3E", "ko": "샤아 대령님은 아직 라라아 씨를", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590F4D", "ko": "잊지 못하고 있어……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "590F74", "ko": "……！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59105D", "ko": "……해치웠나？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591071", "ko": "……아직이다！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591083", "ko": "에잇……그렇다면！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5910A2", "ko": "자네는 자신이 얼마나 위험한 인간인지", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5910B2", "ko": "모르고 있어……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5910C5", "ko": "사람은 흐름에 몸을 맡기면 된다……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5910D8", "ko": "그러니、나는 자네를 죽이겠다！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5910EF", "ko": "……！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591100", "ko": "큭……샤아 녀석！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591116", "ko": "……뭐라고！？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591129", "ko": "샤아도 알고 있을 거잖아！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591139", "ko": "정말 쓰러뜨려야 할 적이 누군지를……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591150", "ko": "자비 가문이라고……？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59116A", "ko": "하지만、내게는 다르다！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591182", "ko": "………！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59119C", "ko": "건담！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5911B3", "ko": "………！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5911CA", "ko": "……아직이다！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5911DF", "ko": "고작 메인 카메라가", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5911EC", "ko": "당했을 뿐이다！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5911FD", "ko": "방금、라라아가 말했어……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59120F", "ko": "뉴타입은…", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591217", "ko": "서로 죽이는 도구가 아니라고……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591235", "ko": "지금 시대에는、사람들이 뉴타입을", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591245", "ko": "서로 죽이는 도구로만 써먹을 뿐이다……！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59125A", "ko": "라라아는 죽을 운명이었던 거다……！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59127E", "ko": "네놈도……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591298", "ko": "……뉴타입이면서！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5912B3", "ko": "대、대령님……！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5912C8", "ko": "설마、샤아 대령님이……！？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5912E0", "ko": "이봐……거짓말이지！？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5912F7", "ko": "가 버렸구나……샤아。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591310", "ko": "아직、내게는……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59131D", "ko": "돌아갈 곳이 있어……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591332", "ko": "여、여기까지인가……？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591340", "ko": "어쩔 수……없겠지。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59134D", "ko": "게다가、모두에게 돌아간다고 해도……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591360", "ko": "살아남는다고 해도、오라버니가……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59137A", "ko": "……안 돼요、세이라 씨！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591393", "ko": "『……안 돼요、세이라 씨！！』", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5913AD", "ko": "……어、아무로！？", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5913C0", "ko": "『모두가 있는 곳으로……』", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5913CF", "ko": "『돌아가요、세이라 씨……！！』", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5913F6", "ko": "그래、그렇지。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591400", "ko": "죽어 버리면 아무 소용 없으니까。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59141B", "ko": "슬슬 물러날 때인가……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591427", "ko": "뭐、연방이 이길 것 같다면", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591436", "ko": "여기서 철수해도 되겠지……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59144E", "ko": "연방군이 공세인 것 같고……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59145D", "ko": "더는 무리할 수 없겠군。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59146F", "ko": "결국 아무로에게 이기지 못했나……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591488", "ko": "큭！ 여기까지인가……！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591496", "ko": "……전원 퇴피！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59151F", "ko": "마음에 안 들었어！ 죽여 버리겠다！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591539", "ko": "이런……단세포 같은 남자군。", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591554", "ko": "……칫！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59155D", "ko": "더는 무리인 것 같군……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591587", "ko": "……시그！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "591593", "ko": "이 바보……", "translation_source": "llm", "review_status": "approved"},
    {"abs": "59159B", "ko": "약속을 어겼、잖아……！！", "translation_source": "llm", "review_status": "approved"},
    {"abs": "5915B9", "ko": "미안하다……", "translation_source": "llm", "review_status": "approved"},
